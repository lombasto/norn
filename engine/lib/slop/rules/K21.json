{
  "id": "K21",
  "level": "BLOCK",
  "kind": "ast",
  "tool": "ast-grep",
  "key": "match",
  "title": "a new environment switch not named NORN_* or missing from the env table (engine/lib/slop/env.md)",
  "explain": {
    "what": "The code reads a new environment variable that is not named NORN_* or has no row in engine/lib/slop/env.md.",
    "why": "Hidden switches change behaviour without a trace. One prefix and one table let anyone find every switch and what it does.",
    "fix": "Name it NORN_<something> and add its row to engine/lib/slop/env.md. Better still, use a setting or a flag."
  },
  "files": ["**/*.mjs","**/*.js","**/*.cjs"],
  "exclude": ["tests/**","**/vendor/**"],
  "token": "([A-Z][A-Z0-9_]+)['\"]?\\]?$",
  "allow": {"token":"^NORN_","listed_in":"engine/lib/slop/env.md"},
  "match": {
    "js": [
      {
        "rule": {
          "kind": "member_expression",
          "has": {"field":"property","kind":"property_identifier","regex":"^[A-Z][A-Z0-9_]+$"},
          "all": [
            {
              "has": {
                "field": "object",
                "any": [{"kind":"identifier","regex":"^env$"},{"kind":"member_expression","has":{"field":"property","regex":"^env$"}}]
              }
            }
          ]
        },
        "message": "a new environment switch: name it NORN_* and give it a row in the env table (engine/lib/slop/env.md)"
      },
      {
        "rule": {
          "kind": "subscript_expression",
          "has": {"field":"index","kind":"string","regex":"^.[A-Z][A-Z0-9_]+.$"},
          "all": [
            {
              "has": {
                "field": "object",
                "any": [{"kind":"identifier","regex":"^env$"},{"kind":"member_expression","has":{"field":"property","regex":"^env$"}}]
              }
            }
          ]
        },
        "message": "a new environment switch (computed): name it NORN_* and give it a row in the env table (engine/lib/slop/env.md)"
      }
    ]
  },
  "fixture": {
    "hit": {
      "base": {"engine/lib/a.mjs":"export const a = 1;\n","engine/lib/slop/env.md":"| name | what |\n| NORN_LISTED | x |\n"},
      "head": {
        "engine/lib/a.mjs": "export const a = 1;\nexport const t = process.env.META_NEW_SWITCH;\nexport const u = env => env['NORN_UNLISTED'];\n",
        "engine/lib/slop/env.md": "| name | what |\n| NORN_LISTED | x |\n"
      },
      "recorded": {
        "head": [
          {"file":"engine/lib/a.mjs","ruleId":"K21.js.0.JavaScript","line":2,"column":18,"endLine":2,"text":"process.env.META_NEW_SWITCH"},
          {"file":"engine/lib/a.mjs","ruleId":"K21.js.1.JavaScript","line":3,"column":25,"endLine":3,"text":"env['NORN_UNLISTED']"}
        ],
        "base": []
      }
    },
    "miss": {
      "base": {"engine/lib/a.mjs":"export const t = process.env.META_OLD;\n","engine/lib/slop/env.md":"| name | what |\n"},
      "head": {
        "engine/lib/a.mjs": "export const t = Number(process.env.META_OLD) || 0;\nexport const n = process.env.NORN_LISTED;\nexport const k = (env, key) => env[key];\n",
        "tests/a.test.mjs": "export const p = process.env.META_TEST_ONLY;\n",
        "engine/lib/slop/env.md": "| name | what |\n| NORN_LISTED | x |\n"
      },
      "recorded": {
        "head": [
          {"file":"engine/lib/a.mjs","ruleId":"K21.js.0.JavaScript","line":1,"column":25,"endLine":1,"text":"process.env.META_OLD"},
          {"file":"engine/lib/a.mjs","ruleId":"K21.js.0.JavaScript","line":2,"column":18,"endLine":2,"text":"process.env.NORN_LISTED"}
        ],
        "base": [{"file":"engine/lib/a.mjs","ruleId":"K21.js.0.JavaScript","line":1,"column":18,"endLine":1,"text":"process.env.META_OLD"}]
      }
    }
  }
}
