{
  "id": "T4",
  "level": "WARN",
  "shadow": true,
  "kind": "ast",
  "tool": "ast-grep",
  "title": "a new or changed test with no assertion",
  "explain": {
    "what": "A test's body has no call that can fail it: no assert, no expect, no throw, no assertion helper.",
    "why": "A test that checks nothing passes whatever the code does. It counts as coverage and proves no behaviour.",
    "fix": "Assert what the code must do: its result, its output or its error. If the test only checks that nothing throws, assert that on purpose (assert.doesNotThrow, pytest.raises in reverse, a Result unwrapped)."
  },
