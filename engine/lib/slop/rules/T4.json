      "head": {
        "tests/a.test.mjs": "import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { parse } from '../src/parse.mjs';\nimport { runCli } from './helpers/cli.mjs';\n\ntest('old smoke', () => { console.log(new Parser()); });\ntest('asserts', () => { assert.deepEqual(parse('a,b'), ['a', 'b']); });\ntest('t.assert', t => { t.assert.equal(parse('').length, 1); });\ntest('named helper', () => { assertRow(parse('a')); });\ntest('plan', t => { t.plan(1); parse('a').forEach(() => t.assert.ok(true)); });\ntest('throws', () => { if (parse('a').length !== 1) throw new Error('one cell'); });\ntest('local helper', () => { roundTrip('a,b'); });\ntest('imported helper', () => { runCli(['parse', 'a']); });\ntest('does not throw', () => { console.log(parse('a')); });\nexport const doc = \"test('x', () => {})\";\nfunction roundTrip(s) { assert.equal(parse(s).join(), s); }\nfunction assertRow(r) { assert.ok(Array.isArray(r)); }\n",
        "tests/test_parse.py": "import pytest\n\nfrom src.parse import _assert_parsable, parse\nfrom tests.helpers import run_cli\n\n\ndef test_asserts():\n    assert parse(\"a,b\") == [\"a\", \"b\"]\n\n\ndef test_raises():\n    with pytest.raises(ValueError):\n        parse(None)\n\n\ndef test_fixture(parsed):\n    parsed(\"a\")\n\n\ndef test_local_helper():\n    round_trip(\"a,b\")\n\n\ndef test_imported_helper():\n    run_cli(\"parse\", \"a\")\n\n\ndef test_importable():\n    from src import parse_strict\n\n\ndef test_attribute_resolves(ctx):\n    _ = ctx.rows\n\n\ndef test_does_not_raise():\n    print(parse(\"a\"))\n\n\nclass TestParse:\n    def test_unittest_style(self):\n        self.assertEqual(parse(\"\"), [\"\"])\n\n    def test_method_helper(self):\n        self._round_trip(\"a\")\n\n    def test_private_named_helper(self):\n        _assert_parsable(\"a\")\n\n    def _round_trip(self, s):\n        assert \",\".join(parse(s)) == s\n\n\ndef round_trip(s):\n    assert \",\".join(parse(s)) == s\n\n\ndef helper_not_a_test():\n    parse(\"a\")\n",
