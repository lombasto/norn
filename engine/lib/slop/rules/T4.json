        "tests/a.test.mjs": "import test from 'node:test';\n"
      },
      "head": {
        "tests/a.test.mjs": "import test from 'node:test';\nimport { parse } from '../src/parse.mjs';\ntest('builds a parser', () => {\n  const p = new Parser();\n  console.log(p);\n});\ntest('parent', async t => {\n  await t.test('sub', () => { console.log(new Parser()); });\n});\nit('empty', function () {});\n",
        "tests/test_parse.py": "from src.parse import parse\n\n\ndef test_builds_a_parser():\n    p = Parser()\n    print(p)\n\n\nclass TestParse:\n    def test_empty(self):\n        logging.info(Parser())\n",
        "src/parse.rs": "pub fn parse(s: &str) -> Vec<&str> { s.split(',').collect() }\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn builds_a_parser() {\n        let p = Parser::new();\n        println!(\"{p:?}\");\n    }\n\n    #[test]\n    #[ignore]\n    fn empty() {\n        let _v: Vec<u8> = vec![];\n    }\n}\n"
      },
