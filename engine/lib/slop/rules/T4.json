    "tests/**",
    "test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test_*.py",
    "**/*_test.py",
    "**/*.rs"
  ],
  "exclude": [
    "**/vendor/**",
    "**/fixtures/**"
  ],
