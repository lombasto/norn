{
  "id": "T4",
  "level": "WARN",
  "shadow": true,
  "kind": "ast",
  "tool": "ast-grep",
  "title": "a new or changed test with no assertion",
  "explain": {
    "what": "A test has no assertion and calls nothing but print / log and constructors: nothing in it can fail.",
    "why": "A test that checks nothing passes whatever the code does. It counts as coverage and proves no behaviour.",
    "fix": "Call the code under test and assert what it must do: its result, its output or its error."
  },
  "files": [
    "tests/**",
    "test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test_*.py",
    "**/*_test.py",
    "**/*.rs"
  ],
  "exclude": [
    "**/vendor/**",
    "**/fixtures/**"
  ],
  "match": {
    "js": [
      {
        "rule": {
          "kind": "call_expression",
          "has": {
            "field": "function",
            "regex": "^(?:test|it)(?:\\.only)?$|^(?:t|tt|ctx|context|st|sub)\\.test$"
          },
          "all": [
            {
              "has": {
                "field": "arguments",
                "has": {
                  "any": [
                    {
                      "kind": "arrow_function"
                    },
                    {
                      "kind": "function_expression"
                    }
                  ],
                  "all": [
                    {
                      "not": {
                        "has": {
                          "stopBy": "end",
                          "kind": "call_expression",
                          "has": {
                            "field": "function",
                            "regex": "(?:^|[.)])_*(?:assert|expect|should|check|verify|ensure|must)\\w*(?:$|[.(])"
                          }
                        }
                      }
                    },
                    {
                      "not": {
                        "has": {
                          "stopBy": "end",
                          "kind": "call_expression",
                          "has": {
                            "field": "function",
                            "regex": "\\.(?:plan|fail)$"
                          }
                        }
                      }
                    },
                    {
                      "not": {
                        "has": {
                          "stopBy": "end",
                          "kind": "throw_statement"
                        }
                      }
                    },
                    {
                      "not": {
                        "has": {
                          "stopBy": "end",
                          "kind": "call_expression",
                          "not": {
                            "has": {
                              "field": "function",
                              "regex": "^console\\.\\w+$"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "message": "a test with no assertion that calls nothing but print / log and constructors: it passes whatever the code does"
      }
    ],
    "py": [
      {
        "rule": {
          "kind": "function_definition",
          "has": {
            "field": "name",
            "regex": "^test"
          },
          "all": [
            {
              "has": {
                "field": "body",
                "all": [
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "assert_statement"
                      }
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "raise_statement"
                      }
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "call",
                        "has": {
                          "field": "function",
                          "regex": "(?:^|\\.)_*(?:assert|expect|should|check|verify|ensure|must|fail|raises|warns|deprecated_call)\\w*$"
                        }
                      }
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "call",
                        "not": {
                          "has": {
                            "field": "function",
                            "regex": "^print$|^(?:logging|logger|log|_log|LOG|_logger)\\.\\w+$|(?:^|\\.)[A-Z]\\w*$"
                          }
                        }
                      }
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "import_statement"
                      }
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "import_from_statement"
                      }
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "attribute",
                        "not": {
                          "inside": {
                            "kind": "call",
                            "field": "function"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          ]
        },
        "message": "a test with no assertion that calls nothing but print / log and constructors: it passes whatever the code does"
      }
    ],
    "rs": [
      {
        "rule": {
          "kind": "function_item",
          "follows": {
            "stopBy": {
              "not": {
                "any": [
                  {
                    "kind": "attribute_item"
                  },
                  {
                    "kind": "line_comment"
                  },
                  {
                    "kind": "block_comment"
                  }
                ]
              }
            },
            "kind": "attribute_item",
            "regex": "^#\\[(?:\\w+::)*(?:test|rstest)\\b"
          },
          "all": [
            {
              "not": {
                "follows": {
                  "stopBy": {
                    "not": {
                      "any": [
                        {
                          "kind": "attribute_item"
                        },
                        {
                          "kind": "line_comment"
                        },
                        {
                          "kind": "block_comment"
                        }
                      ]
                    }
                  },
                  "kind": "attribute_item",
                  "regex": "^#\\[should_panic"
                }
              }
            },
            {
              "has": {
                "field": "body",
                "all": [
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "macro_invocation",
                        "has": {
                          "field": "macro",
                          "regex": "(?:^|::)(?:\\w*assert\\w*|panic|unreachable|todo|unimplemented)$"
                        }
                      }
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "call_expression",
                        "has": {
                          "field": "function",
                          "regex": "\\.(?:unwrap|expect|unwrap_err|expect_err)$"
                        }
                      }
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "try_expression"
                      }
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "call_expression",
                        "has": {
                          "field": "function",
                          "regex": "(?:^|::|\\.)_*(?:assert|expect|should|check|verify|ensure|must)\\w*$"
                        }
                      }
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "call_expression",
                        "not": {
                          "has": {
                            "field": "function",
                            "regex": "^(?:\\w+::)*[A-Z]\\w*(?:::<.*>)?(?:::(?:new|default))?$"
                          }
                        }
                      }
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "macro_invocation",
                        "not": {
                          "has": {
                            "field": "macro",
                            "regex": "^(?:std::)?(?:e?print(?:ln)?|dbg|format|vec|(?:log::|tracing::)?(?:trace|debug|info|warn|error))$"
                          }
                        }
                      }
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "macro_invocation",
                        "all": [
                          {
                            "has": {
                              "field": "macro",
                              "regex": "^(?:std::)?(?:e?print(?:ln)?|dbg|format|vec|(?:log::|tracing::)?(?:trace|debug|info|warn|error))$"
                            }
                          },
                          {
                            "has": {
                              "stopBy": "end",
                              "kind": "token_tree",
                              "follows": {
                                "kind": "identifier"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            }
          ]
        },
        "message": "a test with no assertion that calls nothing but print / log and constructors: it passes whatever the code does"
      }
    ]
  },
  "fixture": {
