{
  "id": "T5",
  "level": "WARN",
  "shadow": true,
  "kind": "ast",
  "tool": "ast-grep",
  "title": "a new or changed test whose every assertion is on a mock it created",
  "explain": {
    "what": "Every assertion of a test is on a mock or stub the same test created: its calls, its call count or the value it was told to return.",
    "why": "Such a test checks the mock, not the code: it passes when the real code is broken, and it breaks only when the mock is rewritten.",
    "fix": "Pass the mock to the real code and assert what the code does with it (its result, or what it sent to the mock); or test the real collaborator."
  },
  "files": [
    "tests/**",
    "test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test_*.py",
    "**/*_test.py",
    "**/*.rs"
  ],
  "exclude": [
    "**/vendor/**",
    "**/fixtures/**"
  ],
  "match": {
